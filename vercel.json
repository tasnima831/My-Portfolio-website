{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "npm ci",
    "buildCommand": "npm run build:vercel",
    "outputDirectory": "dist",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0",
            "maxDuration": 60,
            "excludeFiles": "{node_modules/**,dist/**,tests/**,docs/**,.git/**,.env*,storage/**}"
        }
    },
    "routes": [
        { "src": "/(?:index\\.php|api/index\\.php)", "dest": "/api/index.php" },
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "LOG_CHANNEL": "stderr",
        "LOG_LEVEL": "warning",
        "SESSION_DRIVER": "redis",
        "SESSION_SECURE_COOKIE": "true",
        "SESSION_ENCRYPT": "true",
        "CACHE_STORE": "redis",
        "QUEUE_CONNECTION": "sync",
        "REDIS_CLIENT": "phpredis",
        "REDIS_DB": "0",
        "REDIS_CACHE_DB": "0"
    }
}
